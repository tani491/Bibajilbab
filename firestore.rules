rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (request.auth.token.adminRole == "admin" || request.auth.token.admin == true);
    }

    function isEditor() {
      return signedIn() && request.auth.token.adminRole == "editor";
    }

    function canWriteContent() {
      return isAdmin() || isEditor();
    }

    function isPublished() {
      return resource.data.status == "published";
    }

    function isPublicSetting() {
      return resource.data.isPublic == true;
    }

    match /products/{documentId} {
      allow get, list: if isPublished();
      allow create, update: if canWriteContent();
      allow delete: if isAdmin();
    }

    match /categories/{documentId} {
      allow get, list: if isPublished();
      allow create, update: if canWriteContent();
      allow delete: if isAdmin();
    }

    match /collections/{documentId} {
      allow get, list: if isPublished();
      allow create, update: if canWriteContent();
      allow delete: if isAdmin();
    }

    match /siteSettings/{documentId} {
      allow get, list: if isPublicSetting();
      allow create, update, delete: if isAdmin();
    }

    match /homepageSections/{documentId} {
      allow get, list: if isPublished();
      allow create, update: if canWriteContent();
      allow delete: if isAdmin();
    }

    match /media/{documentId} {
      allow get, list: if isPublished();
      allow create, update: if canWriteContent();
      allow delete: if isAdmin();
    }

    match /testimonials/{documentId} {
      allow get, list: if isPublished();
      allow create, update: if canWriteContent();
      allow delete: if isAdmin();
    }

    match /faqs/{documentId} {
      allow get, list: if isPublished();
      allow create, update: if canWriteContent();
      allow delete: if isAdmin();
    }

    match /orderRequests/{documentId} {
      allow read, update: if canWriteContent();
      allow create, delete: if isAdmin();
    }

    match /inventoryMovements/{documentId} {
      allow read, create: if canWriteContent();
      allow update, delete: if isAdmin();
    }

    match /adminUsers/{documentId} {
      allow read, write: if isAdmin();
    }

    match /auditLogs/{documentId} {
      allow read: if isAdmin();
      allow create: if canWriteContent();
      allow update, delete: if false;
    }

    match /analyticsEvents/{documentId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
